# copy to .env, then: chmod 600 .env
# (.env is gitignored — it holds the one secret that can hand out paid subscriptions)

# your domain. TWO A records must point at this VPS: DOMAIN and api.DOMAIN
DOMAIN=alphanode.example.com

# generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
# the SAME value goes into your payment provider's webhook config — it is the only thing
# standing between the internet and free subscriptions
ALPHAHUB_WEBHOOK_SECRET=

# where hub.db + the vault private key live. OUTSIDE the git clone, so a re-clone or
# `git clean -xdf` can never delete them. Create it first:
#   sudo mkdir -p /srv/alphahub && sudo chown $(id -u):$(id -g) /srv/alphahub && chmod 700 /srv/alphahub
HUBDATA=/srv/alphahub

# the container runs as this uid:gid so the state files are yours, not root's.
# fill with the output of:  id -u   and   id -g
HUB_UID=1000
HUB_GID=1000

# ---- early-access requests by email (optional) ----
# Leave HOST/NOTIFY_TO empty and requests are stored but never mailed; the hub says which on
# startup. Filled in, verify with:  docker compose exec hub python -m alphahub.admin testmail
#
# Do NOT use your registrar's forwarding-only address here: forwarding receives, it does not
# send. You need an SMTP server that will accept a login from this VPS.
#
#   Zoho Mail (free custom-domain mailbox):   smtp.zoho.eu        465  ssl
#   Google Workspace:                         smtp.gmail.com      587  starttls  (app password)
#   Brevo / Mailgun / Resend / SendGrid:      see their SMTP page 587  starttls
ALPHAHUB_SMTP_HOST=
ALPHAHUB_SMTP_PORT=587
# starttls (587), ssl (465), or none. Blank = guessed from the port.
ALPHAHUB_SMTP_TLS=
ALPHAHUB_SMTP_USER=
ALPHAHUB_SMTP_PASS=
# the From address. Providers reject a From they have not verified for you — with a mailbox
# provider this is that mailbox; blank falls back to NOTIFY_TO.
ALPHAHUB_SMTP_FROM=
# where the requests land. Your own inbox; it can be a plain gmail address.
ALPHAHUB_NOTIFY_TO=
