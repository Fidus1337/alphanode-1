# AlphaNode config. Locally:  env $(grep -v '^#' alphanode/alphanode.env | xargs) .venv/bin/python alphanode/node.py
# Or docker --env-file alphanode.env. Anything COMMENTED OUT/empty here is taken from evolution/config.ini.
# The same full set is configurable in the GUI (alphanode_gui.py). Empty value = don't override.

# --- resources / universe ---
ALPHANODE_CPU_PERCENT=20      # 5..95 — how much resources are available (workers = % × cores)
ALPHANODE_UNIVERSE=all        # all  or  BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT

# --- search ---
ALPHANODE_POP=200             # population size per round
ALPHANODE_GENS=25             # generations per round
ALPHANODE_SEED=auto           # auto = unique per install (state/node_id); integer = reproducible
ALPHANODE_PAUSE=5             # pause between rounds, sec
ALPHANODE_STATUS_PORT=8787    # status page port

# --- node mode (continuous search) ---
ALPHANODE_LEADERBOARD=10      # how many best alphas to show/keep at the top
ALPHANODE_EXPLORE_EVERY=4     # every N-th round — pure exploration from scratch (lower -> more diverse)
ALPHANODE_SEED_FROM_LIBRARY=1 # 1 = warm-start from your own library; 0 = always from scratch
# ALPHANODE_MAX_ROUNDS=0      # 0 = forever
# ALPHANODE_STATE_DIR=./alphanode/state

# --- simulation (empty -> from config.ini) ---
# ALPHANODE_TARGET_VOL=0.25   # target annualized portfolio volatility
# ALPHANODE_EXEC_COST=0.001   # fee, fraction of turnover

# --- genome (formula complexity) ---
# ALPHANODE_MAX_DEPTH=6       # max formula-tree depth
# ALPHANODE_MAX_SIZE=22       # max number of nodes in a formula

# --- selection (GA) ---
# ALPHANODE_TOURNAMENT=5      # selection tournament size
# ALPHANODE_ELITISM=6         # how many best pass through unchanged
# ALPHANODE_RANDOM_INJECT=10  # fresh random trees per generation
# ALPHANODE_CROSSOVER_PROB=0.6

# --- fitness ---
# ALPHANODE_PARSIMONY=0.010   # complexity penalty (per node)
# ALPHANODE_CORR_THRESHOLD=0.70  # correlation threshold for deduping champions
# ALPHANODE_CORR_PENALTY=0.5  # penalty for similarity to an already-found alpha
# ALPHANODE_HOF_CAPACITY=15   # Hall of Fame size (champions output per round)

# --- date segments (TRAIN < VAL < TEST; empty -> from config.ini) ---
# ALPHANODE_TRAIN_START=2019-09-05
# ALPHANODE_VAL_START=2021-11-01
# ALPHANODE_TEST_START=2023-01-01
# ALPHANODE_TEST_END=2026-07-05
